<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site1.master.cs" Inherits="CarDelearShip_Project.Site1" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <title></title>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <div>
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                <!DOCTYPE html>
                <html lang="en">
                <head>
                    <meta charset="UTF-8">
                    <meta name="viewport" content="width=device-width, initial-scale=1.0">
                    <title>CarDealer - Buy & Sell Second-Hand Cars</title>
                    <link rel="stylesheet" href="css/styles.css">
                </head>
                <body>
                    <header>
                        <div class="nav-container">
                            <a href="index.html" class="logo">CarDealer</a>
                            <button class="mobile-menu-btn" id="mobileMenuBtn">☰</button>
                            <nav id="mainNav">
                                <ul>
                                    <li><a href="index.html">Home</a></li>
                                    <li><a href="car-buy.html">Buy Cars</a></li>
                                    <li><a href="car-sell.html">Sell Cars</a></li>
                                    <li><a href="all-cars.html">All Cars</a></li>
                                    <li><a href="about.html">About</a></li>
                                    <li><a href="contact.html">Contact</a></li>
                                </ul>
                            </nav>
                        </div>
                    </header>

                    <section class="hero">
                        <div class="hero-content">
                            <h1>Find Your Perfect Car</h1>
                            <p>Buy and sell second-hand cars with confidence</p>
                            <a href="car-buy.html" class="btn">Browse Cars</a>
                            <a href="car-sell.html" class="btn btn-secondary">Sell Your Car</a>
                        </div>
                    </section>
            </asp:ContentPlaceHolder>
            <asp:ContentPlaceHolder ID="ContentPlaceHolder2" runat="server">
                <main>
                    <div class="search-form">
                        <h2>Search Cars</h2>
                        <form>
                            <div class="form-group">
                                <label for="brand">Brand</label>
                                <select id="brand" name="brand">
                                    <option value="">Any Brand</option>
                                    <option value="toyota">Toyota</option>
                                    <option value="honda">Honda</option>
                                    <option value="ford">Ford</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label for="price">Max Price</label>
                                <select id="price" name="price">
                                    <option value="">Any Price</option>
                                    <option value="10000">$10,000</option>
                                    <option value="20000">$20,000</option>
                                </select>
                            </div>
                            <button type="submit" class="btn">Search</button>
                        </form>
                    </div>

                    <h2 class="section-title">Featured Cars</h2>
                    <div class="car-grid">
                        <div class="car-card">
                            <img src="images/car1.jpg" alt="Car 1" class="car-image">
                            <div class="car-details">
                                <h3 class="car-title">Toyota Camry 2022</h3>
                                <div class="car-price">$25,000</div>
                                <div class="car-info">
                                    <span>2022</span>
                                    <span>15,000 km</span>
                                </div>
                                <a href="#" class="btn">View Details</a>
                            </div>
                        </div>
                    </div>
                </main>

            </asp:ContentPlaceHolder>
            <asp:ContentPlaceHolder ID="ContentPlaceHolder3" runat="server">
                <footer>
                    <div class="footer-content">
                        <div class="footer-section">
                            <h3>CarDealer</h3>
                            <p>Your trusted platform for buying and selling second-hand cars with confidence. We connect buyers and sellers in a secure, transparent marketplace.</p>
                            <div class="social-links">
                                <a href="#" title="Facebook">f</a>
                                <a href="#" title="Twitter">t</a>
                                <a href="#" title="Instagram">i</a>
                                <a href="#" title="LinkedIn">in</a>
                            </div>
                        </div>

                        <div class="footer-section">
                            <h3>Quick Links</h3>
                            <ul>
                                <li><a href="car-buy.html">Buy Cars</a></li>
                                <li><a href="car-sell.html">Sell Cars</a></li>
                                <li><a href="all-cars.html">All Cars</a></li>
                                <li><a href="about.html">About Us</a></li>
                                <li><a href="contact.html">Contact</a></li>
                            </ul>
                        </div>

                        <div class="footer-section">
                            <h3>Support</h3>
                            <ul>
                                <li><a href="faq.html">FAQ</a></li>
                                <li><a href="testimonials.html">Testimonials</a></li>
                                <li><a href="contact.html">Help Center</a></li>
                                <li><a href="#">Privacy Policy</a></li>
                                <li><a href="#">Terms of Service</a></li>
                            </ul>
                        </div>

                        <div class="footer-section">
                            <h3>Contact Info</h3>
                            <p>📍 123 Car Street, Auto City, AC 12345</p>
                            <p>📞 (555) 123-4567</p>
                            <p>✉️ info@cardealer.com</p>
                            <p>🕒 Mon-Fri: 9AM-6PM</p>
                        </div>
                    </div>

                    <div class="footer-bottom">
                        <p>&copy; 2024 CarDealer. All rights reserved. | Designed with ❤️ for car enthusiasts</p>
                    </div>
                </footer>

                <script src="js/script.js"></script>
</body>
</html>
</asp:ContentPlaceHolder>
        </div>
    </form>
</body>
</html>
